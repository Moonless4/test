# =============================================================================
# STYLEON / MEDORA — environment template for the self-hosted deployment
# =============================================================================
#
# Copy to `.env` (never commit that file) and fill in your own values:
#
#   cp .env.example .env
#
# This file covers the two halves that read their environment directly:
#
#   * the storefront build (`npm run build`) — the VITE_* block, read by Vite while it builds,
#     so a change needs a rebuild, not a restart.
#   * the payment & commerce service (`node server/index.mjs`) — everything below it, read at
#     process start.
#
# The API and admin panel have their own template: `backend/.env.example`. Nothing here is a
# credential for that application.
#
# The Laravel API does NOT read this file.

# -----------------------------------------------------------------------------
# Storefront build (Vite — baked into the bundle at build time)
# -----------------------------------------------------------------------------

# Where the browser finds the REST API. Leave it relative for the single-origin layout
# (recommended: your web server forwards /api/v1 to the API), or give the API's full URL when
# it lives on its own host — then add the shop's origin to CORS_ALLOWED_ORIGINS in the API's
# own .env, or every request is refused.
VITE_API_BASE_URL=/api/v1

# Which checkout gateway the storefront hands the shopper to:
#   sandbox   the in-app stand-in bank page. Moves no money; needs no service. Default.
#   zarinpal  real money: the browser calls /api/payment/*, which the Node service below
#             answers, and Zarinpal verifies the transaction server-side.
VITE_PAYMENT_GATEWAY=sandbox

# -----------------------------------------------------------------------------
# Payment & commerce service (`node server/index.mjs`)
# -----------------------------------------------------------------------------

# Port the service listens on. It is reached through the shop's own origin under /api/payment
# and /api/commerce, so bind it to the loopback address and let the web server proxy to it —
# do not expose this port publicly.
PAYMENT_API_PORT=8000

# The shop's public origin, without a trailing slash. Zarinpal returns the shopper here, and
# the service refuses a state-changing request that carries a foreign Origin. This must match
# the address shoppers actually use.
SITE_URL=https://shop.example.com

# A second origin allowed to make state-changing calls — only needed while testing from another
# address (a staging domain, a local build). Leave empty in production.
PREVIEW_ORIGIN=

# Zarinpal merchant id (36 characters): zarinpal.com → payment gateway → gateway settings.
# Required for real payments; without it /api/payment/request answers 503 and the checkout
# cannot start an online payment.
ZARINPAL_MERCHANT_ID=

# 1 = Zarinpal's sandbox host (nothing is charged), 0 = live payments. Set 0 in production,
# together with VITE_PAYMENT_GATEWAY=zarinpal above.
ZARINPAL_SANDBOX=1

# -----------------------------------------------------------------------------
# Optional: headless WooCommerce bridge
# -----------------------------------------------------------------------------
#
# The storefront can read a WordPress + WooCommerce site through /api/commerce/*. It is
# INACTIVE while WOO_STORE_URL is empty — every commerce route answers 503 and the UI renders
# its "store not connected" state. Fill these in only if you are actually running that store;
# the keys stay server-side and never reach the browser.

WOO_STORE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WP_APP_USER=
WP_APP_PASSWORD=

# Read cache and upstream timeout for the bridge, in milliseconds.
WOO_CACHE_TTL_MS=45000
WOO_TIMEOUT_MS=12000

<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!--
        `force="true"` on every entry is deliberate and important.

        PHPUnit does not overwrite an environment variable that already exists, so without it the
        surrounding environment wins: in this sandbox that means DB_CONNECTION=mysql from compose,
        and the test suite would run `RefreshDatabase` against the real development database and
        wipe it. With force, the suite always runs against SQLite in memory, with an array cache,
        a sync queue and the fake payment gateway — no network, no external state.
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <!-- No test ever talks to a real payment gateway. -->
        <env name="PAYMENT_GATEWAY" value="fake" force="true"/>
        <env name="PAYMENT_CALLBACK_URL" value="https://api.test/api/v1/payments/callback" force="true"/>
        <!-- Host checking is off by default in tests; RequestGuardTest switches it on deliberately. -->
        <env name="TRUSTED_HOSTS" value="" force="true"/>
        <env name="CORS_ALLOWED_ORIGINS" value="" force="true"/>
        <!-- The test client is not a trusted proxy, so X-Forwarded-* and CF-IPCountry are ignored. -->
        <env name="TRUST_PROXIES" value="" force="true"/>

        <!--
            Second factor: available everywhere, but *not* enforced for staff here.

            Most feature tests are about catalogue, orders and the panel, and they sign in as a
            member of staff with no authenticator. Turning the requirement off for them keeps those
            tests about what they are testing; the enforcement itself is covered by
            tests/Feature/Security/TwoFactorTest.php, which switches it on per test and exercises
            the setup-required and challenge-required refusals directly.
        -->
        <env name="TWO_FACTOR_ENABLED" value="true" force="true"/>
        <env name="TWO_FACTOR_ENFORCE_ADMINS" value="false" force="true"/>
        <!-- No outbound call in the suite; Turnstile tests fake the HTTP client instead. -->
        <env name="TURNSTILE_ENABLED" value="false" force="true"/>
        <!-- The webhook secret is deliberately absent: WebhookSecurityTest sets its own. -->
        <env name="PAYMENT_WEBHOOK_SECRET" value="" force="true"/>
    </php>
</phpunit>

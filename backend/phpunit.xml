<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!--
        `force="true"` on every entry is deliberate and important.

        PHPUnit does not overwrite an environment variable that already exists, so without it the
        surrounding environment wins: in this sandbox that means DB_CONNECTION=mysql from compose,
        and the test suite would run `RefreshDatabase` against the real development database and
        wipe it. With force, the suite always runs against SQLite in memory, with an array cache,
        a sync queue and the fake payment gateway — no network, no external state.
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <!-- No test ever talks to a real payment gateway. -->
        <env name="PAYMENT_GATEWAY" value="fake" force="true"/>
        <env name="PAYMENT_CALLBACK_URL" value="https://api.test/api/v1/payments/callback" force="true"/>
        <!-- Host checking is off by default in tests; RequestGuardTest switches it on deliberately. -->
        <env name="TRUSTED_HOSTS" value="" force="true"/>
        <env name="CORS_ALLOWED_ORIGINS" value="" force="true"/>
    </php>
</phpunit>

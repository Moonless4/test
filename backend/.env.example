# =============================================================================
# Medora API — environment template
#
# Copy to `.env` on the server and fill in the real values there. `.env` is never committed
# (see .gitignore); this template holds no credential, and every blank below must be filled
# on the host, not in the repository.
#
# Generate the application key ON THE SERVER:   php artisan key:generate
# =============================================================================

APP_NAME="مدورا"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

# --- Password hashing ---------------------------------------------------------
# bcrypt is the default because it is available on every DirectAdmin PHP build. Argon2id is
# stronger but needs PHP compiled with libargon2; `php artisan app:preflight` reports whether
# this host has it. See docs/SECURITY.md ("Password hashing").
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12
# Argon2id tuning, used only when HASH_DRIVER=argon2id.
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

# --- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# --- Database (MySQL / MariaDB) -----------------------------------------------
# Create the database and a dedicated user in DirectAdmin; never use the MySQL root account.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=medora_api
DB_USERNAME=medora_api
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT_MODE=true

# --- Sessions / cache / queue -------------------------------------------------
# All three use the database so a shared host needs no Redis and no extra daemon.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=medora_api

QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

# --- Filesystems --------------------------------------------------------------
# `public` holds storefront media (reachable through the /storage symlink),
# `local` holds private documents served only through an authorised controller.
FILESYSTEM_DISK=local
MEDIA_PUBLIC_DISK=public
MEDIA_PRIVATE_DISK=local

# --- Mail ---------------------------------------------------------------------
# DirectAdmin hosting: use the mailbox created in the panel.
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- API security -------------------------------------------------------------
# Comma-separated list of the frontends allowed to call the API with credentials.
# Never `*` for an authenticated API.
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,X-Requested-With,X-Cart-Token
CORS_MAX_AGE=3600

# Comma-separated host allowlist. A leading dot matches the domain and its subdomains.
# Leave empty to disable host checking (Laravel default); production should set it.
TRUSTED_HOSTS=api.example.com,example.com,.example.com

# Behind Apache/LiteSpeed/CyberPanel-DirectAdmin: the web server terminates TLS and forwards
# `X-Forwarded-*`. `*` is only safe when the app is reachable solely through that web server.
TRUST_PROXIES=*

# Access-token lifetime (minutes). Sanctum expires every token after this window.
SANCTUM_TOKEN_TTL=43200
SANCTUM_TOKEN_REFRESH_INTERVAL=null

# Rate limits, per minute, per client (see config/security.php).
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_PASSWORD_RESET=5
RATE_LIMIT_VERIFICATION=3
RATE_LIMIT_API=120
RATE_LIMIT_SENSITIVE=20

# Uploads
UPLOAD_MAX_KB=5120
UPLOAD_IMAGE_MAX_DIMENSION=4000
UPLOAD_ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/avif

# --- Payments (Zarinpal) ------------------------------------------------------
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL="${APP_URL}/api/v1/payments/callback"

# --- Security headers ---------------------------------------------------------
# The frontend origins allowed to embed nothing; the API sends `default-src 'none'`.
CSP_POLICY="default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
SECURITY_HSTS_MAX_AGE=31536000

# --- Backups ------------------------------------------------------------------
BACKUP_DISK=local
BACKUP_KEEP_DAYS=14

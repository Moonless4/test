# =============================================================================
# Medora API — environment template
#
# Copy to `.env` on the server and fill in the real values there. `.env` is never committed
# (see .gitignore); this template holds no credential, and every blank below must be filled
# on the host, not in the repository.
#
# Generate the application key ON THE SERVER:   php artisan key:generate
# =============================================================================

APP_NAME="مدورا"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

# --- Password hashing ---------------------------------------------------------
# bcrypt is the default because it is available on every DirectAdmin PHP build. Argon2id is
# stronger but needs PHP compiled with libargon2; `php artisan app:preflight` reports whether
# this host has it. See docs/SECURITY.md ("Password hashing").
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12
# Argon2id tuning, used only when HASH_DRIVER=argon2id.
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

# --- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# --- Database (MySQL / MariaDB) -----------------------------------------------
# Create the database and a dedicated user in DirectAdmin; never use the MySQL root account.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=medora_api
DB_USERNAME=medora_api
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT_MODE=true

# --- Sessions / cache / queue -------------------------------------------------
# All three use the database so a shared host needs no Redis and no extra daemon.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=medora_api

QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

# --- Filesystems --------------------------------------------------------------
# `public` holds storefront media (reachable through the /storage symlink),
# `local` holds private documents served only through an authorised controller.
FILESYSTEM_DISK=local
MEDIA_PUBLIC_DISK=public
MEDIA_PRIVATE_DISK=local

# --- Mail ---------------------------------------------------------------------
# DirectAdmin hosting: use the mailbox created in the panel.
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- API security -------------------------------------------------------------
# Comma-separated list of the frontends allowed to call the API with credentials.
# Never `*` for an authenticated API.
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,X-Requested-With,X-Cart-Token
CORS_MAX_AGE=3600

# Comma-separated host allowlist. A leading dot matches the domain and its subdomains.
# Leave empty to disable host checking (Laravel default); production should set it.
TRUSTED_HOSTS=api.example.com,example.com,.example.com

# Whose `X-Forwarded-*` headers are believed. EMPTY IS CORRECT for a plain DirectAdmin account:
# Apache/LiteSpeed runs PHP itself and puts the real client address in REMOTE_ADDR, so
# `X-Forwarded-For` is only a header the caller chose. Believing it lets a client pick its own
# address and walk around the login lockout, the per-IP rate limits and the sign-in monitoring.
#
# Set it only to addresses that can ONLY be the app's own front-end proxy: the CDN's published
# ranges (Cloudflare/ArvanCloud) if one sits in front of the site, a load balancer's address, or
# 127.0.0.1,::1 when the host's own web server reverse-proxies to the app over loopback.
# `*` means "every peer is a proxy" and is only safe when there is no other way in — never on
# shared hosting.
TRUST_PROXIES=

# Access-token lifetime (minutes). Sanctum expires every token after this window.
# 720 = 12 hours: long enough for a shop session, short enough that a leaked token is not a
# permanent key. Never leave this empty on a host that handles real money.
SANCTUM_TOKEN_TTL=720
SANCTUM_TOKEN_REFRESH_INTERVAL=null

# Rate limits, per minute, per client (see config/security.php).
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_PASSWORD_RESET=5
RATE_LIMIT_VERIFICATION=3
RATE_LIMIT_API=120
RATE_LIMIT_SENSITIVE=20
# Endpoint-specific budgets: second-factor codes, re-authentication, the admin API, token
# operations, inbound webhooks and uploads each get their own.
RATE_LIMIT_TWO_FACTOR=6
RATE_LIMIT_RECENT_AUTH=5
RATE_LIMIT_ADMIN=60
RATE_LIMIT_TOKEN=10
RATE_LIMIT_WEBHOOK=60
RATE_LIMIT_UPLOAD=10

# --- Administrator two-factor authentication (TOTP) ---------------------------
# enforce_admins=true means a staff account cannot reach /admin until it has confirmed an
# authenticator code, and must pass the challenge at every login. Without that, a leaked
# administrator password alone would open the panel.
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ENFORCE_ADMINS=true
TWO_FACTOR_ISSUER="${APP_NAME}"
TWO_FACTOR_WINDOW=1
TWO_FACTOR_RECOVERY_CODES=8
TWO_FACTOR_CHALLENGE_TTL=5
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_ATTEMPT_DECAY=15

# --- Login shield (brute force / credential stuffing) ------------------------
# After this many failures from one email+address pair, that pair is locked for the lockout
# window. The lock is temporary and pair-keyed on purpose: a permanent lock, or one keyed on the
# email alone, would let anybody lock a known administrator out of the shop.
LOGIN_SHIELD_MAX_FAILURES=5
LOGIN_SHIELD_LOCKOUT_MINUTES=15
LOGIN_SHIELD_DECAY_MINUTES=30
LOGIN_SHIELD_DELAY_MS=250
LOGIN_SHIELD_DELAY_CAP_MS=1000
LOGIN_SHIELD_TRAVEL_HOURS=12
LOGIN_SHIELD_SESSION_WATCH=5

# How long a re-authentication (password re-entry) stays valid for one token, in minutes.
RECENT_AUTH_TTL=15

# --- Bot protection (Cloudflare Turnstile) -----------------------------------
# Off by default. Turn it on only with a real site/secret pair; it then guards login, register
# and password-reset, and nothing else.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Outbound request guard (SSRF) -------------------------------------------
# Every server-side outbound call must resolve to a public address. Restrict the hosts further
# with a comma-separated allowlist when the shop only ever calls known services.
OUTBOUND_TIMEOUT=5
OUTBOUND_CONNECT_TIMEOUT=3
OUTBOUND_ALLOWED_HOSTS=
OUTBOUND_ALLOW_PRIVATE=false

# --- Security log retention ---------------------------------------------------
AUDIT_RETENTION_DAYS=365
LOGIN_ATTEMPT_RETENTION_DAYS=90

# Uploads
UPLOAD_MAX_KB=5120
UPLOAD_IMAGE_MAX_DIMENSION=4000
UPLOAD_ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/avif

# --- Payments (Zarinpal) ------------------------------------------------------
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL="${APP_URL}/api/v1/payments/callback"
# Where the gateway's callback sends the shopper's browser next (the storefront's result page).
# Leave empty to answer the callback with JSON only — useful while wiring the SPA up.
PAYMENT_FRONTEND_RETURN_URL=

# Shared secret for the gateway's server-to-server notification (POST /api/v1/payments/webhook).
# The endpoint answers 503 until it is set, and every request must carry an HMAC-SHA256 signature
# over "<timestamp>.<body>" plus an unused idempotency key. Generate it with:
#     php -r "echo bin2hex(random_bytes(32));"
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE=300

# --- Security headers ---------------------------------------------------------
# The frontend origins allowed to embed nothing; the API sends `default-src 'none'`.
CSP_POLICY="default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
SECURITY_HSTS_MAX_AGE=31536000

# --- Backups ------------------------------------------------------------------
BACKUP_DISK=local
BACKUP_KEEP_DAYS=14
